{
  "name": "@samishan11/moto-contract",
  "version": "0.1.0",
  "description": "Shared API contract (Zod schemas + inferred types) for moto-backend and moto-client.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samishan11/moto-contract.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
